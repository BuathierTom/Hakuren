{
  "name": "kizunadex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=24.0.0" },
  "packageManager": "npm@11.21.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @kizunadex/api",
    "dev:web": "npm run dev --workspace @kizunadex/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --import tsx --test apps/api/test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "npm run start --workspace @kizunadex/api",
    "db:migrate": "node --import tsx apps/api/src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
